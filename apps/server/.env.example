PORT=4000
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:4000
DATABASE_PATH=./data/cyberpath.db
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
COOKIE_SECURE=false
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=10
MAIL_MODE=console
MAIL_FROM=noreply@cyberpath.local
# MAIL_MODE=brevo sends real email through Brevo's HTTP API
BREVO_API_KEY=
# First admin when seeding a production database
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALL_FEATURES_FREE=false
ENABLE_DEMO_BILLING=true
SUPPORT_EMAIL=support@cyberpath.local
LOG_LEVEL=info

STRIPE_WEBHOOK_SECRET=
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz/api
DEFAULT_LOCALE=en
